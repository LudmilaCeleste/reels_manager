rules_version = '2';

// Reglas de arranque: cualquier usuario autenticado (con cuenta de Google
// dada de alta en el proyecto) puede leer y escribir. Es intencionalmente
// simple para esta primera etapa, con un equipo chico y de confianza.
// Cuando haga falta distinguir roles (por ejemplo, que no cualquiera
// pueda borrar clientes), se ajusta acá.
//
// Cómo aplicarlas: Firebase Console -> Firestore Database -> pestaña
// "Rules" -> pegar este contenido -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
